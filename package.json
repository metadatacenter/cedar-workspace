{
  "name": "cedar-workspace",
  "version": "2.9.34-SNAPSHOT",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "description": "CEDAR Workspace frontend",
  "scripts": {
    "start": "node tools/workspace.mjs start",
    "test": "ng test --watch=false && node --test tools/*.test.mjs",
    "lint": "eslint src",
    "build": "ng build && node tools/stage-workspace.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" angular.json tsconfig*.json",
    "build:deployment": "node tools/workspace.mjs build",
    "configure": "node tools/workspace.mjs configure",
    "copy:cee": "node tools/workspace.mjs copy-cee",
    "test:browser": "npm --prefix browser test",
    "test:visual": "bash browser/run-visual.sh"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.6": true,
    "fsevents@2.3.3": true
  },
  "author": "Metadatacenter.org",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@ngx-translate/core": "~18.0.0",
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20261107.g5294fab4514e.t2016",
    "cedar-embeddable-editor": "2.0.33",
    "cedar-model-typescript-library": "npm:@org.metadatacenter/cedar-model-typescript-library@1.0.28-dev.20261107.g06be587cca8c.t2016",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  }
}
