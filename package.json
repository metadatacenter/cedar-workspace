{
  "name": "cedar-workspace",
  "version": "2.9.19-SNAPSHOT",
  "publishConfig": {
    "registry": "https://nexus.bmir.stanford.edu/repository/npm-cedar/"
  },
  "description": "CEDAR Workspace frontend",
  "scripts": {
    "start": "node tools/workspace.mjs start",
    "test": "ng test --watch=false && node --test tools/*.test.mjs",
    "build": "ng build && node tools/stage-workspace.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" angular.json tsconfig*.json",
    "build:deployment": "node tools/workspace.mjs build",
    "configure": "node tools/workspace.mjs configure",
    "copy:cee": "node tools/workspace.mjs copy-cee",
    "test:browser": "npm --prefix browser test",
    "test:visual": "bash browser/run-visual.sh"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.3": true
  },
  "author": "Metadatacenter.org",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@ngx-translate/core": "^18.0.0",
    "@org.metadatacenter/cedar-design-tokens": "0.1.0-dev.20260924.ef34ac69",
    "cedar-embeddable-editor": "2.0.17",
    "rxjs": "~7.8.2",
    "selecto": "1.26.3",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
